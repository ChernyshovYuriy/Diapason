    <string name="fach_name_dramatic_soprano">سوبرانو درامية</string>
    <string name="fach_description_dramatic_soprano">نبرة قوية ثقيلة نافذة، مصنوعة لملء القاعات الكبيرة فوق الأوركسترات الضخمة.</string>
    <string name="fach_name_lyric_mezzo_soprano">ميتزو سوبرانو غنائية</string>
    <string name="fach_description_lyric_mezzo_soprano">طبقة وسطى غنية مع رشاقة، وكثيرًا ما تُسند إليها أدوار الفتيان.</string>
    <string name="fach_name_dramatic_mezzo_soprano">ميتزو سوبرانو درامية</string>
    <string name="fach_description_dramatic_mezzo_soprano">داكنة، ثقيلة، مهيبة — تتقن أدوار الأشرار والساحرات والأمهات المأساويات.</string>
    <string name="fach_name_contralto">كونترالتو</string>
    <string name="fach_description_contralto">أندر صوت نسائي — طبقة منخفضة ترابية رنّانة وعميقة.</string>
    <string name="fach_name_countertenor">كونترتينور</string>
    <string name="fach_description_countertenor">صوت رجالي يستخدم الفالسيتو/صوت الرأس في مدى الألتو–الميتزو، متخصص في موسيقى الباروك.</string>
    <string name="fach_name_lyric_tenor">تينور غنائي</string>
    <string name="fach_description_lyric_tenor">مشرق، عذب، أنيق — البطل الرومانسي النموذجي.</string>
    <string name="fach_name_spinto_tenor">تينور سبينتو</string>
    <string name="fach_description_spinto_tenor">جوهر غنائي بحدّة درامية — قادر على إطالة النغمات العالية القوية.</string>
    <string name="fach_name_dramatic_tenor_heldentenor">تينور درامي (هيلدنتينور)</string>
    <string name="fach_description_dramatic_tenor_heldentenor">ضخم وبطولي، مصنوع لفاغنر — التحمّل قبل الرشاقة.</string>
    <string name="fach_name_lyric_baritone">باريتون غنائي</string>
    <string name="fach_description_lyric_baritone">ناعم، دافئ، نبيل — أبطال جذّابون وأبطال مضادّون رومانسيون.</string>
    <string name="fach_name_kavalierbariton">كافاليرباريتون</string>
    <string name="fach_description_kavalierbariton">الباريتون الأنيق الأرستقراطي — مهيب لكنه راقٍ.</string>
    <string name="fach_name_dramatic_baritone">باريتون درامي</string>
    <string name="fach_description_dramatic_baritone">داكن، قوي، حادّ — الشرير الفيردي النموذجي والأب المأساوي.</string>
    <string name="fach_name_bass_baritone">باص باريتون</string>
    <string name="fach_description_bass_baritone">يجمع عمق الباص ورشاقة الباريتون — مثالي لأشرار فاغنر البطوليين.</string>
    <string name="fach_name_basso_cantante">باص كانتانتي</string>
    <string name="fach_description_basso_cantante">الباص الغنائي — دافئ، شاعري، ليغاتو؛ ملوك حكماء وآباء عطوفون.</string>
    <string name="fach_name_basso_profundo">باص بروفوندو</string>
