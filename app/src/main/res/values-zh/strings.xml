    <string name="fach_name_coloratura_soprano">花腔女高音</string>
    <string name="fach_description_coloratura_soprano">极其灵活敏捷，音域高入云霄，音色轻盈剔透。</string>
    <string name="fach_name_lyric_coloratura_soprano">抒情花腔女高音</string>
    <string name="fach_description_lyric_coloratura_soprano">高音区明亮辉煌，兼具温暖音色与富有表现力的连音。</string>
    <string name="fach_name_lyric_soprano">抒情女高音</string>
    <string name="fach_description_lyric_soprano">音色温暖流畅、情感丰富——最常见的女高音类型。</string>
    <string name="fach_name_spinto_soprano">戏剧抒情女高音</string>
    <string name="fach_description_spinto_soprano">以抒情音色为基础，融入戏剧性的张力与更为深沉的音色。</string>
    <string name="fach_name_dramatic_soprano">戏剧女高音</string>
    <string name="fach_description_dramatic_soprano">音色强劲、厚重、穿透力强，足以在大型乐队伴奏下响彻整个音乐厅。</string>
    <string name="fach_name_lyric_mezzo_soprano">抒情女中音</string>
    <string name="fach_description_lyric_mezzo_soprano">中音区丰满且灵活，常出演反串（男装）角色。</string>
    <string name="fach_name_dramatic_mezzo_soprano">戏剧女中音</string>
    <string name="fach_description_dramatic_mezzo_soprano">音色深沉厚重、气势逼人——擅长演绎反派、女巫和悲剧母亲等角色。</string>
    <string name="fach_name_contralto">女低音</string>
    <string name="fach_description_contralto">最罕见的女声——质朴浑厚，低音区深邃共鸣。</string>
    <string name="fach_name_countertenor">假声男高音</string>
    <string name="fach_description_countertenor">男声运用假声/头声演唱于女低音至女中音音域，尤擅巴洛克曲目。</string>
    <string name="fach_name_lyric_tenor">抒情男高音</string>
    <string name="fach_description_lyric_tenor">音色明亮甜美、优雅动人——典型的浪漫男主角声部。</string>
    <string name="fach_name_spinto_tenor">戏剧抒情男高音</string>
    <string name="fach_description_spinto_tenor">以抒情音色为核心，带有戏剧性的锋芒——能够持续唱出强有力的高音。</string>
    <string name="fach_name_dramatic_tenor_heldentenor">戏剧男高音（英雄男高音）</string>
    <string name="fach_description_dramatic_tenor_heldentenor">音量宏大、气势英雄——专为瓦格纳而生，重耐力而非灵活性。</string>
    <string name="fach_name_lyric_baritone">抒情男中音</string>
    <string name="fach_description_lyric_baritone">音色圆润温暖、高贵典雅——擅演迷人的男主角与浪漫的反英雄。</string>
    <string name="fach_name_kavalierbariton">绅士男中音</string>
    <string name="fach_description_kavalierbariton">优雅而具贵族气质的男中音——威严中不失精致。</string>
    <string name="fach_name_dramatic_baritone">戏剧男中音</string>
    <string name="fach_description_dramatic_baritone">音色深沉、强劲有力——威尔第歌剧中反派与悲剧父亲的典型声部。</string>
    <string name="fach_name_bass_baritone">男低中音</string>
    <string name="fach_description_bass_baritone">兼具男低音的深沉与男中音的灵活——最适合瓦格纳笔下的英雄反派角色。</string>
    <string name="fach_name_basso_cantante">抒情男低音</string>
    <string name="fach_description_basso_cantante">歌唱性男低音——音色温暖抒情、连音流畅；擅演智慧的国王与仁慈的父亲。</string>
    <string name="fach_name_basso_profundo">深沉男低音</string>
    <string name="fach_description_basso_profundo">乐队中最低沉的人声——气势磅礴、音色空灵，低音如雷鸣般震撼。</string>
    <string name="fach_name_contrabass_oktavist">最低音（俄式深低音）</string>
    <string name="fach_description_contrabass_oktavist">极为罕见——俄罗斯东正教合唱传统中的超低音专才。</string>
